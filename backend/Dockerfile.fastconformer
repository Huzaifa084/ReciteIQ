# Backend image with the NeMo FastConformer engine, for the container-level
# resource gate. Separate from the production Dockerfile so nothing shipping
# changes while this is measured.
FROM python:3.12-slim

WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends \
        libsndfile1 ffmpeg git && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml ./
RUN pip install --no-cache-dir tomli && python - <<'PY' > /tmp/reqs.txt
import tomli
d = tomli.load(open("pyproject.toml", "rb"))
print("\n".join(d["project"]["dependencies"] + d["project"]["optional-dependencies"]["asr"]))
PY
RUN pip install --no-cache-dir -r /tmp/reqs.txt
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu \
    && pip install --no-cache-dir "nemo_toolkit[asr]"

COPY app ./app
COPY alembic ./alembic
COPY alembic.ini ./
COPY scripts ./scripts

ENV OMP_NUM_THREADS=2 \
    RECITEIQ_ASR_ENGINE=fastconformer \
    RECITEIQ_TRACKER_MODE=whisper \
    HF_HOME=/hf
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=240s \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/healthz', timeout=3)"
CMD ["sh", "-c", "uvicorn app.main:app --host 0.0.0.0 --port 8000 --log-level info"]
